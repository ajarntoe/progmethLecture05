<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox fx:id="hboxRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="5.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MyController">
		
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <TextField fx:id="outputField" prefWidth="200.0" />
      <Button fx:id="myButton" mnemonicParsing="false" onAction="#showDateTime" text="Show Date Time" textFill="#1d1d1e">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</HBox>
